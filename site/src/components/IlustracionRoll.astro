---
/**
 * Ilustración de un roll — la representación de los ocho productos SIN foto
 * verificada (M04-C03).
 *
 * ── Por qué esto y no un número en un cuadrado ─────────────────────────────
 * El número decorativo era el tratamiento provisional: cumple «no inventar una
 * foto», pero no dice nada del producto, y ocho tarjetas con un «07» repetido
 * se leen como un catálogo sin contenido.
 *
 * Aquí cada roll tiene un DETALLE GRÁFICO PROPIO, construido con el topping que
 * la carta le da. No es un adorno ni un relleno: es la información que
 * distingue un roll de otro.
 *
 *   California · ajonjolí tostado
 *   Furai      · empanizado (miga dorada)
 *   Acevichado · zigzag de salsa acevichada
 *   Garlic     · salsa garlic con vetas
 *   Kitsune    · salsa secreta con lascas de nori
 *   Parmesano  · parmesano rallado y gajo de limón
 *   Parrillero · láminas de lomo a la parrilla y salsa parrillera
 *   Yakiniku   · láminas de lomo y salsa yakiniku
 *
 * ── Es ilustración, y se declara ───────────────────────────────────────────
 * La tarjeta lleva la etiqueta visible «Ilustración» y el `role="img"` con un
 * nombre que lo dice. En ningún punto se presenta como la fotografía de una
 * receta: son piezas geométricas estilizadas, no un plato.
 *
 * ── Accesibilidad ──────────────────────────────────────────────────────────
 * `role="img"` con `aria-label`: el lector de pantalla lee la descripción del
 * gráfico. La ilustración NO es decorativa, porque dice algo. Y como el texto
 * de la tarjeta ya nombra los ingredientes, el `aria-label` no repite la
 * tarjeta: describe lo que el DIBUJO añade.
 */
interface Props {
  /** Clave del roll; decide el topping. */
  roll: string;
  class?: string;
}

const { roll, class: clase = '' } = Astro.props;

/** Topping de cada roll, con los colores de la carta. */
const TOPPING: Record<string, { etiqueta: string; tipo: string }> = {
  California: { etiqueta: 'coronado con ajonjolí tostado', tipo: 'sesamo' },
  Furai: { etiqueta: 'empanizado, con miga dorada', tipo: 'miga' },
  Acevichado: { etiqueta: 'coronado con salsa acevichada', tipo: 'zigzag-coral' },
  Garlic: { etiqueta: 'bañado en salsa garlic', tipo: 'zigzag-crema' },
  Kitsune: { etiqueta: 'coronado con la salsa de la casa', tipo: 'salsa-nori' },
  Parmesano: { etiqueta: 'con parmesano rallado y limón', tipo: 'queso-limon' },
  Parrillero: { etiqueta: 'con láminas de lomo y salsa parrillera', tipo: 'lomo' },
  Yakiniku: { etiqueta: 'con láminas de lomo y salsa yakiniku', tipo: 'lomo' },
};

const t = TOPPING[roll] ?? { etiqueta: 'roll de la casa', tipo: 'sesamo' };
const aria = `Ilustración de la sección de un roll ${roll}: ${t.etiqueta}. No es una fotografía del plato.`;
---

<svg
  class={`ilustracion-roll ${clase}`}
  viewBox="0 0 96 96"
  role="img"
  aria-label={aria}
  data-ilustracion={roll}
>
  <!-- Fondo: la superficie -->
  <rect x="0" y="0" width="96" height="96" rx="10" fill="#0d0f21" />

  <!-- Plato visto desde arriba -->
  <circle cx="48" cy="48" r="38" fill="#1a1f42" />
  <circle cx="48" cy="48" r="38" fill="none" stroke="#ff6b5a" stroke-width="1.6" opacity="0.55" />

  <!-- La sección del maki: arroz, nori, relleno -->
  <circle cx="48" cy="48" r="25" fill="#1d3324" />
  <circle cx="48" cy="48" r="21" fill="#fff8ec" />
  <circle cx="48" cy="48" r="10" fill="#e8734a" />
  <circle cx="48" cy="48" r="4" fill="#f5efe0" opacity="0.85" />

  {
    /* ── El topping: lo que hace que este roll sea ESTE roll ── */
    t.tipo === 'sesamo' && (
      <g fill="#f5efe0" opacity="0.9">
        {[
          [38, 36], [58, 38], [34, 52], [62, 54], [44, 62], [54, 30],
          [30, 42], [66, 44], [50, 68], [40, 28], [58, 66], [28, 60],
        ].map(([cx, cy]) => (
          <ellipse cx={cx} cy={cy} rx="2.4" ry="1.3" transform={`rotate(${(cx * 7) % 90} ${cx} ${cy})`} />
        ))}
      </g>
    )
  }
  {
    t.tipo === 'miga' && (
      <g>
        <circle cx="48" cy="48" r="25" fill="none" stroke="#d9a441" stroke-width="4" stroke-dasharray="3 4" opacity="0.9" />
        <circle cx="48" cy="48" r="25" fill="none" stroke="#f0c96a" stroke-width="1.4" stroke-dasharray="2 5" />
      </g>
    )
  }
  {
    t.tipo === 'zigzag-coral' && (
      <path
        d="M30 40 L38 32 L46 42 L54 34 L62 44 L68 38"
        fill="none"
        stroke="#ff6b5a"
        stroke-width="3.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    t.tipo === 'zigzag-crema' && (
      <path
        d="M30 44 L36 34 L42 46 L48 36 L54 48 L60 38 L66 48"
        fill="none"
        stroke="#f5efe0"
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        opacity="0.92"
      />
    )
  }
  {
    t.tipo === 'salsa-nori' && (
      <g>
        <path
          d="M30 42 Q48 26 66 42"
          fill="none"
          stroke="#ff9a6b"
          stroke-width="4"
          stroke-linecap="round"
        />
        <path d="M40 27 l6 5 -8 2 z" fill="#1d3324" />
        <path d="M58 25 l5 6 -9 1 z" fill="#1d3324" />
      </g>
    )
  }
  {
    t.tipo === 'queso-limon' && (
      <g>
        {[
          [36, 32], [50, 28], [62, 34], [30, 46], [68, 48], [44, 24], [58, 22],
        ].map(([cx, cy]) => (
          <rect x={cx} y={cy} width="3" height="2.2" rx="1" fill="#fff8ec" opacity="0.85" transform={`rotate(${(cx * 11) % 60} ${cx} ${cy})`} />
        ))}
        <path d="M64 62 a9 9 0 0 1 0 -12 l0 12 z" fill="#f2d34a" />
        <path d="M64 62 a9 9 0 0 0 9 -9" fill="none" stroke="#fff8ec" stroke-width="1.2" />
      </g>
    )
  }
  {
    t.tipo === 'lomo' && (
      <g>
        {[
          [34, 36, -18], [48, 30, -18], [62, 36, -18],
        ].map(([x, y, r]) => (
          <rect
            x={x}
            y={y}
            width="20"
            height="7"
            rx="3.5"
            fill="#8c4a2f"
            transform={`rotate(${r} ${x + 10} ${y + 3.5})`}
          />
        ))}
        {[
          [34, 36, -18], [48, 30, -18], [62, 36, -18],
        ].map(([x, y, r]) => (
          <rect
            x={x + 1}
            y={y + 2.4}
            width="18"
            height="2.2"
            rx="1.1"
            fill="#5d2c1c"
            opacity="0.7"
            transform={`rotate(${r} ${x + 10} ${y + 3.5})`}
          />
        ))}
      </g>
    )
  }

  <!-- Grano de arroz: el detalle que separa el dibujo de un icono plano -->
  <g fill="#fff8ec" opacity="0.5">
    <circle cx="24" cy="76" r="1.1" /><circle cx="31" cy="80" r="0.9" />
    <circle cx="70" cy="74" r="1" /><circle cx="76" cy="79" r="0.8" />
  </g>
</svg>

<style>
  .ilustracion-roll {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    border-radius: var(--radius-control);
  }
</style>
