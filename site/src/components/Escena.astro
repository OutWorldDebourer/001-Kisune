---
import MascotMotion from './MascotMotion.astro';
import { visualFor } from '../data/visuals';
const poster = visualFor('California')!.image;
---

<figure class="escena" data-escena>
  <div class="escena-stage">
    <img class="escena-poster" src={poster.src} alt="Ilustración de presentación de makis con ebi furai, palta y ajonjolí." width={poster.width} height={poster.height} loading="eager" fetchpriority="high" decoding="async" data-escena-poster />
    <canvas class="escena-canvas" data-escena-canvas width="768" height="768" aria-hidden="true"></canvas>
    <span class="escena-index" aria-hidden="true">01 / CALIFORNIA</span>
    <button type="button" class="escena-vista" data-escena-vista aria-pressed="false" hidden>Explorar en 3D</button>
    <button type="button" class="escena-pausa" data-escena-pausa aria-pressed="false" hidden>Pausar movimiento</button>
    <div class="escena-mascota"><MascotMotion decorative sizes="72px" /></div>
  </div>
  <figcaption><span>Una mirada al roll.</span><span>Ilustración de presentación</span></figcaption>
</figure>

<style>
  .escena { margin-inline: auto; width: 100%; max-width: 34rem; }
  .escena-stage { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 2rem; background: radial-gradient(ellipse at 40% 25%, #f8f2e9, #e5dccb); box-shadow: 0 30px 70px -30px #0008; }
  .escena-poster, .escena-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .escena-poster { object-fit: cover; }
  .escena-canvas { opacity: 0; display: block; touch-action: pan-y; }
  .escena[data-estado='viva'] .escena-canvas { opacity: 1; }
  .escena[data-estado='viva'] .escena-poster { opacity: 0; }
  .escena-index { position: absolute; top: 1.4rem; left: 1.5rem; color: #394053; font-size: .65rem; font-weight: 700; letter-spacing: .14em; }
  .escena-mascota { position: absolute; right: 1rem; bottom: 1rem; width: 72px; }
  .escena-pausa { position: absolute; bottom: 1rem; left: 1rem; min-height: 44px; padding: .5rem .8rem; border-radius: 999px; border: 1px solid #39405330; background: #f8f2e9e6; color: #394053; font-size: .65rem; cursor: pointer; }
  .escena-vista { position: absolute; top: .6rem; right: .75rem; z-index: 2; min-height: 44px; padding: .5rem .8rem; border-radius: 999px; background: #101526e8; color: #f5efe5; font-size: .7rem; font-weight: 600; cursor: pointer; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .35rem; padding: .9rem .2rem 0; font-size: .65rem; color: #f5efe58c; }
  figcaption span:first-child { color: #f5efe5c7; }
  @media (max-width: 639px) { .escena { max-width: 24rem; } .escena-mascota { width: 56px; } }
</style>
