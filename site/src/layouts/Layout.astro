---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Carta digital 2026 de Kitsune Makis — makis por bandeja, especiales y bebidas. Pide por WhatsApp: 988 843 683',
} = Astro.props;

// URL canónica desde la config de Astro (site: en astro.config.mjs).
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4422').href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicAsset = (path: string) => `${base}/${path}`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101526" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / WhatsApp: sin og:image el enlace se comparte sin vista previa -->
    <meta property="og:site_name" content="Kitsune Makis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={new URL(publicAsset('og-kitsune.png'), Astro.site ?? 'http://localhost:4422').href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Kitsune Makis — logo con olas seigaiha y plato de makis"
    />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>

    <!-- Fuentes autoalojadas (subsets del uso real). Se precargan las dos que
         pintan el primer viewport: la VARIABLE de Montserrat (un solo archivo
         100-900 cubre todos los pesos, y es el peso del texto del LCP) y la
         display del hero. La clase .js NO se añade aquí: lo hace el mismo
         script que crea el IntersectionObserver (components/Reveal.astro),
         para que un fallo de JS no pueda dejar la carta invisible. -->
    <link
      rel="preload"
      href={publicAsset('fonts/montserrat-var-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={publicAsset('fonts/mochiy-pop-one-latin-400.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href={publicAsset('favicon.svg')} />
    <link rel="apple-touch-icon" href={publicAsset('favicon.svg')} />
  </head>
  <body class="bg-kitsune-navy font-sans text-kitsune-cream antialiased">
    <slot />
  </body>
</html>
